# Banco de dados
DB_URL=jdbc:postgresql://localhost:5432/financeapp
DB_USERNAME=financeapp
DB_PASSWORD=financeapp

# JWT - gere uma string aleatória forte (>= 32 caracteres) para produção
JWT_SECRET=troque-isto-por-uma-string-aleatoria-bem-grande-em-producao
JWT_EXPIRATION_MS=86400000

# CORS - domínio do frontend em produção (ex: https://seu-app.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173

PORT=8080

# Usuário master - o único usuário do app (você e sua esposa usam este MESMO
# e-mail e senha para logar). Só tem efeito na primeira subida, com o banco
# ainda vazio; depois disso pode remover essas linhas com segurança.
MASTER_USER_NAME=Familia
MASTER_USER_EMAIL=familia@seuemail.com
MASTER_USER_PASSWORD=troque-por-uma-senha-forte
